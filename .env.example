# Copy to .env and fill in your project's values.
# VITE_-prefixed vars are exposed in the client bundle; never put real secrets there.

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
VITE_SUPABASE_PROJECT_URL=

# Modern client key: Dashboard > Project Settings > API keys > Publishable key
VITE_SUPABASE_PUBLISHABLE_KEY=

# App origin (dev: http://localhost:5173). Keep in sync with Supabase
# Auth > URL config and Google OAuth redirect URIs.
VITE_SITE_URL=

# Web client ID from Google Cloud Console (OAuth client for the web platform).
# Used by @capawesome/capacitor-google-sign-in. Required for Google sign-in.
VITE_GOOGLE_WEB_CLIENT_ID=

# ============================================================
# Server-side values below are NOT bundled into the client
# (no VITE_ prefix on purpose). They are read by:
#   - Cypress QA seeding (cypress.config.ts)
#   - scripts/backend-setup.sh (syncs them as Supabase edge secrets)
# Keep them out of anything committed or shipped.
# ============================================================

# Supabase secret key: Dashboard > Project Settings > API keys > Secret key
SUPABASE_SECRET_KEY=

# AI providers (edge functions prefer OpenRouter, fall back to OpenAI)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=
OPENAI_API_KEY=

# M-Pesa / Daraja (Production target app; price in KES)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_PRICE=1
