# Copy to .env and fill in your project's values.
# VITE_-prefixed vars are exposed in the client bundle; never put secrets here.

# Supabase project URL, e.g. https://xxxx.supabase.co
VITE_SUPABASE_PROJECT_URL=

# Client-side keys (either is fine; publishable key is the modern replacement)
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# App origin (dev: http://localhost:5173). Keep in sync with Supabase
# Auth > URL config and Google OAuth redirect URIs.
VITE_SITE_URL=

# Web client ID from Google Cloud Console (OAuth client for the web platform).
# Used by @capawesome/capacitor-google-sign-in. Required for Google sign-in.
VITE_GOOGLE_WEB_CLIENT_ID=

# NOT for the client: the Supabase service role key belongs only in
# Edge Function secrets (`supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...`).
